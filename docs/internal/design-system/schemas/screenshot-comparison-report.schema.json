{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miguel-design-os.local/schemas/screenshot-comparison-report.schema.json",
  "title": "Miguel Design OS Screenshot Comparison Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectName",
    "runName",
    "createdAt",
    "targetImagePath",
    "currentImagePath",
    "dimensions",
    "dimensionsMatch",
    "layoutMatchNotes",
    "focalObjectMatchNotes",
    "typographyMatchNotes",
    "spacingMatchNotes",
    "extraMissingUiNotes",
    "exactRemainingDifferences",
    "blockingDifferences"
  ],
  "properties": {
    "projectName": { "type": "string", "minLength": 1 },
    "runName": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "targetImagePath": { "type": "string", "minLength": 1 },
    "currentImagePath": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "current"],
      "properties": {
        "target": { "$ref": "#/$defs/dimensions" },
        "current": { "$ref": "#/$defs/dimensions" }
      }
    },
    "dimensionsMatch": { "type": "boolean" },
    "layoutMatchNotes": { "type": "string" },
    "focalObjectMatchNotes": { "type": "string" },
    "typographyMatchNotes": { "type": "string" },
    "spacingMatchNotes": { "type": "string" },
    "extraMissingUiNotes": { "type": "string" },
    "exactRemainingDifferences": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockingDifferences": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "known"],
      "properties": {
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "known": { "type": "boolean" }
      }
    }
  }
}
