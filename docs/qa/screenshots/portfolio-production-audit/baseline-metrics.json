  {
    "file": "baseline-desktop-story.png",
    "width": 1440,
    "height": 900,
    "title": "The Story — Miguel Almeida",
    "url": "/story",
    "scrollWidth": 1440,
    "innerWidth": 1440,
    "bodyTextLength": 2815,
    "h1": "Dear reader,",
    "headings": [
      {
        "tag": "H1",
        "text": "Dear reader,"
      },
      {
        "tag": "H2",
        "text": "I spend years in aviation, learning what real stakes feel like."
      },
      {
        "tag": "H2",
        "text": "I graduate as a UX/UI designer from the UX Design Institute."
      },
      {
        "tag": "H2",
        "text": "I open a code editor, freelance my first projects."
      },
      {
        "tag": "H2",
        "text": "I join F24 and learn what shipping at scale means."
      },
      {
        "tag": "H2",
        "text": "I build a product from scratch, and watch it go to thousands of users."
      },
      {
        "tag": "H2",
        "text": "I'm promoted to mid-level software engineer. This is me saying hello."
      },
      {
        "tag": "H2",
        "text": "If you'd rather keep it practical."
      }
    ],
    "horizontalOverflow": false
  }
