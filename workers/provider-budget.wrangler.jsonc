{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "portfolio-provider-budget",
  "main": "provider-budget.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "vars": { "DAILY_CALL_LIMIT": "100" },
  "durable_objects": { "bindings": [{ "name": "PORTFOLIO_BUDGET", "class_name": "PortfolioBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PortfolioBudget"] }]
}
