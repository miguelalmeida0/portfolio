{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 4173 --strictPort",
    "prepare": "svelte-kit sync",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "npm run check",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "verify": "npm run check:repo && npm run check && npm run test:unit && npm run build",
    "e2e:install": "playwright install chromium firefox webkit",
    "e2e": "npm run e2e:install && npm run e2e:ci",
    "e2e:ci": "mkdir -p .cache/tmp && TMPDIR=$PWD/.cache/tmp playwright test",
    "e2e:against-server": "npm run e2e:install && mkdir -p .cache/tmp && TMPDIR=$PWD/.cache/tmp PLAYWRIGHT_SKIP_WEB_SERVER=1 playwright test",
    "e2e:report": "playwright show-report",
    "e2e:ui": "npm run e2e:install && mkdir -p .cache/tmp && TMPDIR=$PWD/.cache/tmp playwright test --ui",
    "ci": "npm run verify && npm run e2e:ci",
    "qa:capture-revamp": "node scripts/capture-content-revamp-qa.mjs",
    "preview": "npm run build && npm run start",
    "start": "wrangler pages dev .svelte-kit/cloudflare --ip 127.0.0.1 --port 4173 --log-level error --show-interactive-dev-session=false",
    "check:repo": "node scripts/ci/check-repository-hygiene.mjs"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.28.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.1",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "wrangler": "4.137.0"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.4"
  }
}
